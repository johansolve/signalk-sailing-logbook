{
  "name": "signalk-sailing-logbook",
  "version": "0.10.2",
  "displayName": "Sailing Logbook",
  "description": "Automatic sailing logbook for Signal K: detects trips, counts tacks and gybes, and reports hourly wind and heel statistics. Replays a whole passage on the map and exports it as a video, rendered entirely in your browser. English and Swedish.",
  "main": "plugin/index.js",
  "files": [
    "plugin/",
    "public/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha",
    "lint": "eslint ."
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-utility"
  ],
  "signalk": {
    "displayName": "Sailing Logbook",
    "appIcon": "logo.svg",
    "screenshots": [
      "docs/playback.png",
      "docs/screenshot.png"
    ],
    "requires": [
      "signalk-to-influxdb"
    ],
    "recommends": [
      "@meri-imperiumi/signalk-alternator-engine-on"
    ]
  },
  "signalk-plugin-enabled-by-default": false,
  "author": "Johan Solve",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johansolve/signalk-sailing-logbook.git"
  },
  "bugs": {
    "url": "https://github.com/johansolve/signalk-sailing-logbook/issues"
  },
  "homepage": "https://github.com/johansolve/signalk-sailing-logbook#readme",
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.0.0",
    "mocha": "^11.0.0"
  }
}
