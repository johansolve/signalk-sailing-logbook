{
  "name": "signalk-sailing-logbook",
  "version": "0.1.0",
  "description": "Automatic sailing logbook: detects trips from SOG, logs tacks/gybes, and reports hourly wind and heel statistics computed from the onboard InfluxDB.",
  "main": "plugin/index.js",
  "scripts": {
    "test": "mocha",
    "lint": "eslint ."
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-utility"
  ],
  "signalk-plugin-enabled-by-default": false,
  "author": "Johan Solve",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johansolve/signalk-sailing-logbook.git"
  },
  "bugs": {
    "url": "https://github.com/johansolve/signalk-sailing-logbook/issues"
  },
  "homepage": "https://github.com/johansolve/signalk-sailing-logbook#readme",
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.0.0",
    "mocha": "^11.0.0"
  },
  "comment": "recommends: install one of these to provide propulsion.<n>.state for the motoring/sailing distinction",
  "recommends": [
    "signalk-engine-state",
    "signalk-alternator-engine-on"
  ]
}
